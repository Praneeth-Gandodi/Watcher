# Backend base URL for the Watcher frontend.
#
# In development Vite proxies /api to this URL, so the browser only ever talks
# to its own origin and no CORS configuration is needed. Leave it unset to use
# the local default (http://127.0.0.1:8000).
#
# For a built bundle served by another host, set it to that backend's origin,
# e.g. https://api.example.internal
VITE_API_BASE_URL=http://127.0.0.1:8000

# Polling cadence in milliseconds while the simulation is running.
# Lower is smoother but chatty; the UI slows this down automatically when the
# fleet is large or the simulation is paused.
VITE_POLL_INTERVAL_MS=400
VITE_POLL_INTERVAL_IDLE_MS=1200
